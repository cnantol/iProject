# ===== 复制为 .env 后再填值（.env 切勿提交到 git）=====
# 必改：JWT 签名密钥，请改成一段足够长的随机字符串
# 生成示例：openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string

# 服务端口（容器内外一致）
PORT=3001

# SQLite 数据库与上传文件目录（容器内已挂载卷持久化）
DATA_DIR=/app/data

# 是否位于反向代理之后：IP 直连或套 Caddy/Nginx 都填 1 即可（影响 X-Forwarded-Proto 判断）
TRUST_PROXY=1

# 中文字体路径（Dockerfile 已安装 wqy-zenhei）
CJK_FONT_PATH=/usr/share/fonts/truetype/wqy/wqy-zenhei.ttc
CJK_SERIF_FONT_PATH=/usr/share/fonts/truetype/wqy/wqy-zenhei.ttc
CJK_MONO_FONT_PATH=/usr/share/fonts/truetype/wqy/wqy-zenhei.ttc

# ===== 访问模式 =====
# 模式 A（默认可用）：IP:3001 直连，无需以下两项，应用容器端口已暴露。
#
# 模式 B（域名 + HTTPS）：启用 caddy 的 https profile 前填写这两项
#   1) 在云服务商把 DOMAIN 的 A 记录指向本机公网 IP
#   2) 云控制台防火墙放通 TCP 80 与 443
#   3) 启动： docker compose --profile https up -d
# 留空则只走 IP:3001；填了且启用 https profile 后自动走 https://域名
DOMAIN=
# 申请 Let's Encrypt 证书用的联系邮箱（HTTPS 模式必填）
ACME_EMAIL=
