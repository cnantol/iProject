# ===== 复制为 .env 后再填值（.env 切勿提交到 git）=====
# 必改：JWT 签名密钥，请改成一段足够长的随机字符串
# 生成示例：openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string

# 服务端口（容器内外一致）
PORT=3001

# SQLite 数据库与上传文件目录（容器内已挂载卷持久化）
DATA_DIR=/app/data

# 是否位于反向代理之后：直接用 IP 访问填 0 或 1 均可；套 Nginx 填 1
TRUST_PROXY=1

# 中文字体路径（Dockerfile 已安装 wqy-zenhei）
CJK_FONT_PATH=/usr/share/fonts/truetype/wqy/wqy-zenhei.ttc
CJK_SERIF_FONT_PATH=/usr/share/fonts/truetype/wqy/wqy-zenhei.ttc
CJK_MONO_FONT_PATH=/usr/share/fonts/truetype/wqy/wqy-zenhei.ttc
